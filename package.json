{
  "name": "capital-market-feed",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:ui": "playwright test",
    "test:analysis-public": "node --conditions=react-server --import tsx scripts/verify-analysis-public.ts",
    "worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/quote-worker.ts",
    "archive:init": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/archive-init.ts",
    "test:release": "node scripts/verify-production.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:public": "node scripts/verify-public.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "lightweight-charts": "^5.2.1",
