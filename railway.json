{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker"
  },
  "deploy": {
    "startCommand": "npm run worker",
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "us-east4-eqdc4a": { "numReplicas": 1 }
    },
    "overlapSeconds": "0",
    "drainingSeconds": "30"
  }
}
